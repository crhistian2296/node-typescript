{
  "name": "07-RESTWeb",
  "version": "1.0.0",
  "description": "",
  "main": "index.js",
  "scripts": {
    "dev": "node --watch --import tsx/esm src/app.ts",
    "build": "tsc && node scripts/copy-public.mjs",
    "start": "node ./dist/src/app.js",
    "docker:test": "docker compose -f docker-compose.test.yml --env-file .env.test up -d",
    "db:test:migrate": "node --env-file=.env.test node_modules/prisma/dist/prisma.js db migrate",
    "test": "pnpm run docker:test && pnpm run db:test:migrate && vitest",
    "test:watch": "pnpm run docker:test && pnpm run db:test:migrate && vitest --watch",
    "test:coverage": "pnpm run docker:test && pnpm run db:test:migrate && vitest --coverage",
    "contract:emit": "prisma contract emit",
    "format:prisma": "prisma contract format"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "devEngines": {
    "packageManager": {
      "name": "pnpm",
      "version": "^11.1.2",
      "onFail": "download"
    }
  },
  "type": "module",
  "devDependencies": {
    "@types/express": "^5.0.6",
    "@types/node": "^26.6.3",
    "eslint": "^10.11.0",
    "prettier": "^3.9.9",
    "tsx": "^4.23.15",
    "vitest": "^5.0.2",
    "typescript": "^7.0.2"
  },
  "dependencies": {
    "dotenv": "^18.0.4",
    "env-var": "^7.5.0",
    "express": "^5.3.0"
  }
}
