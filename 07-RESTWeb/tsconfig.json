{
  "compilerOptions": {
    "types": ["node", "vitest/globals"],
    "target": "ES2022",
    "module": "esnext",
    "moduleResolution": "bundler",
    "outDir": "./dist",
    "rootDir": ".",
    "strict": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "sourceMap": true,
    "ignoreDeprecations": "6.0",
    "resolveJsonModule": true
  },
  "include": ["src/**/*", "test-env.setup.ts"],
  "exclude": ["node_modules", "dist"]
}
